sim_output.*
api/_outputs/

# Large local source surveillance data (kept out of git — too big for GitHub)
web/Data/

# Local tool / editor settings
.claude/
.vscode/
.DS_Store

# Vitest / Vite cache
.vite/

# Reference documents kept locally (ICAO PANS-ATM is a copyrighted publication)
*.pdf

# Source AIXM exports kept locally: Navigraph/Jeppesen-derived commercial data,
# licensed for internal and demonstration use only, NOT for redistribution. The
# layers built from it (web/public/data/aixm_vy/ etc.) are committed so the
# app runs from a clean clone; re-running the scripts/ingest_aixm_*.py scripts
# needs your own copy of the export.
# (matches both the gzipped export and the plain-XML one.)
aixm_export_*.xml
aixm_export_*.xml.gz

# Report charting (scripts/plot_reports.py): downloaded CSVs in, PNGs out.
# Both hold run output, not source.
/csv/
/graphs/

.vercel
.env*
